# ZitaJobs - producción/desarrollo
NODE_ENV=production
PORT=10000

# PostgreSQL de Supabase
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_SSL=true
DB_POOL_MAX=5

# JWT - genera un secreto largo y aleatorio
JWT_SECRET=REEMPLAZA_CON_UN_SECRET_ALEATORIO_DE_AL_MENOS_64_CARACTERES
JWT_EXPIRES_IN=7d

# Frontend: puedes poner varias URLs separadas por coma
FRONTEND_URL=https://TU-FRONTEND.vercel.app

# Supabase Storage (NUNCA expongas SERVICE_ROLE_KEY al frontend)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REEMPLAZA_CON_SERVICE_ROLE_KEY
SUPABASE_CV_BUCKET=cvs
SUPABASE_LOGO_BUCKET=logos

MAX_FILE_SIZE_MB=5
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Solo para demo/local. En producción déjalo false.
SEED_DEMO_DATA=false

# ─── v1.2 (todas opcionales; sin ellas el sitio funciona igual) ────────────────
# Correos (recuperar contraseña, postulaciones, moderación). Render Free bloquea SMTP,
# por eso se usa la API HTTP de Brevo o Resend. Ver README → "Correos".
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=ZitaJobs
# URL pública del sitio para los enlaces de los correos (si no, se usa la primera FRONTEND_URL)
PUBLIC_FRONTEND_URL=

# Moderación
# true = las vacantes de empresas SIN verificar quedan "pendientes" hasta que las apruebes
REQUIRE_JOB_APPROVAL=false
# Reportes abiertos (de personas distintas) para ocultar una vacante automáticamente
REPORTS_AUTOHIDE_THRESHOLD=3
